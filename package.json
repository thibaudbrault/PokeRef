{
  "name": "pokeref",
  "description": "A Pokemon encyclopedia",
  "version": "1.0.0",
  "private": true,
  "author": "Thibaud Brault",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "starter",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "type": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prettier": "prettier --ignore-path .gitignore \"src/**/*.+(ts|js|tsx)\"",
    "prettier:write": "prettier --ignore-path .gitignore \"src/**/*.+(ts|js|tsx)\" --write",
    "style": "stylelint \"src/**/*.scss\"",
    "style:fix": "stylelint \"src/**/*.scss\" --fix",
    "postinstall": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@meronex/icons": "4.0.0",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-query": "5.90.20",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.18",
    "@vercel/analytics": "1.6.1",
    "axios": "^1.13.4",
    "class-variance-authority": "0.7.1",
    "fuse.js": "7.1.0",
    "next": "16.1.6",
    "next-pwa": "5.6.0",
    "nextjs-progressbar": "0.0.16",
    "react": "19.2.4",
    "react-circular-progressbar": "2.2.0",
    "react-dom": "19.2.4",
    "react-error-boundary": "6.1.0",
    "react-hook-form": "7.71.1",
    "react-hot-toast": "2.6.0",
    "react-modal": "3.16.3",
    "react-paginate": "8.3.0",
    "react-select": "5.10.2",
    "react-tooltip": "5.30.0",
    "react-virtual": "2.10.4",
    "uuid": "13.0.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.7.1",
    "@tanstack/eslint-plugin-query": "5.91.4",
    "@types/node": "25.1.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/react-modal": "3.16.3",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "sass": "1.97.3",
    "stylelint": "17.1.0",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "ts-node": "10.9.2",
    "typed-scss-modules": "8.1.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "./src/**/*.{ts,js,jsx,tsx}": [
      "pnpm lint:fix",
      "pnpm prettier:write"
    ],
    "./src/**/*.scss": [
      "pnpm style:fix"
    ]
  }
}
